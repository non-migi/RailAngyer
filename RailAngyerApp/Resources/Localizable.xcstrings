    "いまの区間（%@）と最大出目 %lld で作ります。プレイを始めると変更できません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの区間（%@）と最大出目 %lld で作ります。プレイを始めると変更できません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be created with the current section (%@) and highest roll %lld. This can’t be changed once play begins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt mit dem aktuellen Abschnitt (%@) und höchstem Wurf %lld. Nach Spielbeginn nicht mehr änderbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creará con el tramo actual (%@) y tirada máxima %lld. No se puede cambiar una vez empezado el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé avec la section actuelle (%@) et la valeur max du dé %lld. Impossible à modifier une fois la partie commencée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금의 구간(%@)과 최대 눈 %lld로 만듭니다. 플레이를 시작하면 변경할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет создана с текущим участком (%@) и максимумом на кубике %lld. После начала игры изменить нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将以当前区间（%@）和最大点数 %lld 创建。开始游玩后无法更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान खंड (%@) और अधिकतम अंक %lld के साथ बनाया जाएगा। खेल शुरू होने के बाद बदला नहीं जा सकता।"
          }
        }
      }
    },
    "参加すると、ルームの旅に切り替わります": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加すると、ルームの旅に切り替わります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining switches you to the room’s journey"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beitritt wechselst du zur Reise des Raums"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al unirte, cambiarás al viaje de la sala"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En rejoignant, vous passez au voyage du salon"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
