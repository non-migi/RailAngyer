          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽签包含自己的任务"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मिशन भी ड्रॉ में शामिल करें"
          }
        }
      }
    },
    "自分で書いたお題が自分に当たることがあります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で書いたお題が自分に当たることがあります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mission you wrote may be drawn for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine selbst geschriebene Aufgabe kann dir selbst zufallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una misión escrita por ti puede tocarte a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un défi que vous avez écrit peut vous être attribué."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신이 쓴 미션이 자신에게 걸릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам может выпасть задание, написанное вами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己写的任务可能会抽到自己。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लिखा मिशन आपको ही मिल सकता है।"
          }
        }
      }
    },
    "自分で書いたお題は自分には当たりません。人数ぶんのお題が足りないと、お題なしで進む駅が出ます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で書いたお題は自分には当たりません。人数ぶんのお題が足りないと、お題なしで進む駅が出ます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missions you wrote are never drawn for you. If there aren’t enough missions for everyone, some stations will have none."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst geschriebene Aufgaben fallen dir nie selbst zu. Reichen die Aufgaben nicht für alle, bleiben manche Stationen ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las misiones escritas por ti nunca te tocan a ti. Si no hay misiones suficientes para todos, habrá estaciones sin misión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défis que vous avez écrits ne vous sont jamais attribués. S’il n’y en a pas assez pour tous, certaines stations resteront sans défi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신이 쓴 미션은 자신에게 걸리지 않습니다. 인원수만큼 미션이 모자라면 미션 없이 지나가는 역이 생깁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написанные вами задания вам не выпадают. Если заданий на всех не хватит, на некоторых станциях их не будет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己写的任务不会抽到自己。如果任务数量不够人数，会出现没有任务的车站。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लिखा मिशन आपको नहीं मिलेगा। सबके लिए पर्याप्त मिशन न हों तो कुछ स्टेशन बिना मिशन के रहेंगे।"
          }
        }
      }
    },
    "お題は出しません。駅を巡って歩くだけの予定になります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お題は出しません。駅を巡って歩くだけの予定になります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No missions will be given. This plan is simply about walking from station to station."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Aufgaben. Der Termin besteht nur aus dem Wandern von Station zu Station."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá misiones. Será un plan de solo caminar de estación en estación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun défi ne sera proposé. Ce sera une simple marche de station en station."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션은 내지 않습니다. 역을 돌며 걷기만 하는 일정이 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заданий не будет. Этот план — просто прогулка от станции к станции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不出任务。这将是只逛车站步行的计划。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई मिशन नहीं होगा। यह योजना सिर्फ़ स्टेशन-स्टेशन घूमकर चलने की होगी।"
