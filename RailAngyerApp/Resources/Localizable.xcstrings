    "県をまたぐ路線は、通るどちらの県からも選べます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "県をまたぐ路線は、通るどちらの県からも選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines that cross prefecture borders can be chosen from any prefecture they pass through."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien über Präfekturgrenzen hinweg findest du in jeder Präfektur, die sie durchqueren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas que cruzan varias prefecturas se pueden elegir desde cualquiera de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes traversant plusieurs préfectures sont proposées dans chacune d’elles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 현을 지나는 노선은 지나는 어느 현에서든 선택할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линии, проходящие через несколько префектур, доступны в каждой из них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨县的线路可从其经过的任一县中选择。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई प्रान्तों से गुज़रने वाली लाइनें उनमें से किसी भी प्रान्त से चुनी जा सकती हैं।"
          }
        }
      }
    },
