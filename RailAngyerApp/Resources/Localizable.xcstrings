    "着いた駅でお題を1つ引いて、みんなで一緒に取り組みます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着いた駅でお題を1つ引いて、みんなで一緒に取り組みます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the station you land on, one mission is drawn and everyone works on it together."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der erreichten Station wird eine Aufgabe gezogen, die alle gemeinsam angehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la estación a la que llegues se saca una misión y todos la hacen juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la station atteinte, un défi est tiré et tout le monde s’y attaque ensemble."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착한 역에서 미션을 1개 뽑아 다 같이 함께 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На станции, куда вы попали, вытягивается одно задание, и все выполняют его вместе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在到达的车站抽取一个任务，大家一起完成。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस स्टेशन पर पहुँचें वहाँ एक मिशन निकाला जाता है और सब मिलकर उसे करते हैं।"
          }
        }
      }
    },
    "着いた駅で、めいめいが自分のお題を引きます。引いたお題はその人の端末に残ります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着いた駅で、めいめいが自分のお題を引きます。引いたお題はその人の端末に残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the station you land on, each person draws their own mission. The drawn mission stays on that person’s device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der erreichten Station zieht jeder seine eigene Aufgabe. Die gezogene Aufgabe bleibt auf dem Gerät der Person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la estación a la que llegues, cada uno saca su propia misión. La misión sacada queda en el dispositivo de esa persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la station atteinte, chacun tire son propre défi. Le défi tiré reste sur l’appareil de la personne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착한 역에서 각자 자신의 미션을 뽑습니다. 뽑은 미션은 그 사람의 기기에 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На станции, куда вы попали, каждый вытягивает своё задание. Оно остаётся на устройстве этого человека."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在到达的车站，每人各自抽取自己的任务。抽到的任务保留在那个人的设备上。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस स्टेशन पर पहुँचें वहाँ हर व्यक्ति अपना मिशन निकालता है। निकाला गया मिशन उसी के डिवाइस पर रहता है।"
          }
        }
      }
    },
