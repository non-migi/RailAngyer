    "スタートとゴールを決めます。環状のコースなら一周もできます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタートとゴールを決めます。環状のコースなら一周もできます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the start and goal. On a loop course, you can also go all the way around."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Start und Ziel fest. Auf einer Ringstrecke ist auch eine ganze Runde möglich."
