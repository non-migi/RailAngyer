          }
        }
      }
    },
    "阪急京都本線と札幌市電の駅・電停の位置に使っています。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "阪急京都本線と札幌市電の駅・電停の位置に使っています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for the station and tram-stop locations of the Hankyu Kyoto Main Line and the Sapporo Streetcar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Stations- und Haltestellenstandorte der Hankyu-Kyoto-Hauptlinie und der Straßenbahn Sapporo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para la ubicación de las estaciones y paradas de la línea principal Hankyu Kioto y del tranvía de Sapporo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour la position des stations et arrêts de la ligne principale Hankyu Kyoto et du tramway de Sapporo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한큐 교토 본선과 삿포로 시덴의 역·정류장 위치에 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для координат станций и остановок линии Ханкю Киото и трамвая Саппоро."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于阪急京都本线及札幌市电的车站·电车站位置。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हांक्यू क्योटो मुख्य लाइन और साप्पोरो ट्राम के स्टेशनों व स्टॉप की स्थिति के लिए उपयोग किया जाता है।"
          }
        }
      }
    },
