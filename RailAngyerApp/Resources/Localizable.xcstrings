          }
        }
      }
    },
    "本文を読み込めませんでした。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を読み込めませんでした。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text konnte nicht geladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le texte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문을 불러오지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取正文。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठ लोड नहीं किया जा सका।"
          }
        }
      }
    },
    "ルームの中で表示されます。\n**いま参加しているルームからは抜けます。**この端末の記録は残ります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームの中で表示されます。\n**いま参加しているルームからは抜けます。**この端末の記録は残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown inside the room.\n**You will leave the room you are in now.** Records on this device will remain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Raum angezeigt.\n**Du verlässt deinen aktuellen Raum.** Die Aufzeichnungen auf diesem Gerät bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mostrará dentro de la sala.\n**Saldrás de la sala en la que estás ahora.** Los registros de este dispositivo se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché dans le salon.\n**Vous quitterez le salon actuel.** Les enregistrements de cet appareil seront conservés."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방 안에서 표시됩니다.\n**지금 참가 중인 방에서는 나가게 됩니다.** 이 기기의 기록은 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в комнате.\n**Вы покинете текущую комнату.** Записи на этом устройстве сохранятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在房间内显示。\n**你将退出当前加入的房间。**本机记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम के अंदर दिखाया जाएगा।\n**आप अभी जिस रूम में हैं उससे बाहर हो जाएँगे।** इस डिवाइस के रिकॉर्ड बने रहेंगे।"
          }
        }
      }
    },
    "ルームの中で表示されます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームの中で表示されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown inside the room."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Raum angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mostrará dentro de la sala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché dans le salon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방 안에서 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в комнате."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在房间内显示。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम के अंदर दिखाया जाएगा।"
          }
        }
      }
    },
    "参加できませんでした。電波の届くところで試してください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加できませんでした。電波の届くところで試してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not join. Try again where you have a signal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitritt fehlgeschlagen. Versuch es dort, wo du Empfang hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo unir. Inténtalo donde haya cobertura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rejoindre. Réessayez là où vous avez du réseau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참가하지 못했습니다. 전파가 닿는 곳에서 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось присоединиться. Попробуйте там, где есть связь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加入。请在有信号的地方重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शामिल नहीं हो सके। जहाँ नेटवर्क हो वहाँ फिर से कोशिश करें।"
          }
        }
      }
    },
    "招待コードが違います。リンクが古いかもしれません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードが違います。リンクが古いかもしれません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invite code is wrong. The link may be outdated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einladungscode stimmt nicht. Der Link ist vielleicht veraltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de invitación no es válido. Puede que el enlace sea antiguo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d’invitation est incorrect. Le lien est peut-être périmé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드가 다릅니다. 링크가 오래되었을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный код приглашения. Возможно, ссылка устарела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请码不正确。链接可能已过期。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण कोड गलत है। हो सकता है लिंक पुराना हो।"
          }
        }
      }
    },
    "「送信待ちの記録」は、まだ仲間に届いていないサイコロ・到着・写真・お題・予定の数です。電波が戻ればまとめて送られるので、このままで大丈夫です。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「送信待ちの記録」は、まだ仲間に届いていないサイコロ・到着・写真・お題・予定の数です。電波が戻ればまとめて送られるので、このままで大丈夫です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Records waiting to send” is the number of dice rolls, arrivals, photos, missions, and plans that haven’t reached your friends yet. They will be sent together once you have a signal again, so there is nothing you need to do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ausstehende Aufzeichnungen“ ist die Zahl der Würfe, Ankünfte, Fotos, Aufgaben und Termine, die die anderen noch nicht erreicht haben. Sobald wieder Empfang besteht, werden sie gesammelt gesendet – du musst nichts tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Registros pendientes de envío» es el número de tiradas, llegadas, fotos, misiones y planes que aún no han llegado a tus compañeros. Se enviarán todos juntos cuando vuelva la cobertura, así que no tienes que hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Enregistrements en attente d’envoi » désigne le nombre de lancers, arrivées, photos, défis et rendez-vous qui n’ont pas encore atteint vos compagnons. Ils seront envoyés ensemble dès que le réseau reviendra : vous n’avez rien à faire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘전송 대기 중인 기록’은 아직 동료에게 전달되지 않은 주사위·도착·사진·미션·일정의 수입니다. 전파가 돌아오면 한꺼번에 전송되므로 그대로 두어도 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Записи в очереди на отправку» — это число бросков, прибытий, фото, заданий и планов, которые ещё не дошли до товарищей. Когда связь появится, они отправятся все сразу — ничего делать не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“待发送的记录”是指尚未送达同伴的骰子、到达、照片、任务和计划的数量。信号恢复后会一并发送，无需担心。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“भेजे जाने की प्रतीक्षा में रिकॉर्ड” उन पासों, आगमनों, तस्वीरों, मिशनों और योजनाओं की संख्या है जो अभी साथियों तक नहीं पहुँचे हैं। नेटवर्क लौटते ही ये एक साथ भेज दिए जाएँगे, इसलिए चिंता की बात नहीं है।"
          }
        }
      }
    },
    "いま進めている旅（%lld駅・%@）は「過去の旅」に保存されます。写真もそのまま残ります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま進めている旅（%lld駅・%@）は「過去の旅」に保存されます。写真もそのまま残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current journey (%lld stations · %@) will be saved to “Past journeys”. Photos will also remain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Reise (%lld Stationen · %@) wird unter „Vergangene Reisen“ gespeichert. Auch die Fotos bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viaje en curso (%lld estaciones · %@) se guardará en «Viajes pasados». Las fotos también se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voyage en cours (%lld stations · %@) sera enregistré dans « Voyages passés ». Les photos seront également conservées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 진행 중인 여행(%lld개 역·%@)은 '지난 여행'에 저장됩니다. 사진도 그대로 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий поход (%lld станций · %@) будет сохранён в «Прошлые походы». Фото тоже останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前进行中的旅程（%lld 站·%@）将保存到“过去的旅程”。照片也会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा यात्रा (%lld स्टेशन · %@) “पिछली यात्राएँ” में सहेज दी जाएगी। तस्वीरें भी बनी रहेंगी।"
          }
        }
      }
    },
    "%@ツアー": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
