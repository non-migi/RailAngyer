      }
    },
    "画面を見るときは立ち止まってください。到着は自動で判定されるので、歩きながら見る必要はありません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を見るときは立ち止まってください。到着は自動で判定されるので、歩きながら見る必要はありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop walking when you look at the screen. Arrival is detected automatically, so there’s no need to watch while walking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib stehen, wenn du auf den Bildschirm schaust. Die Ankunft wird automatisch erkannt, du musst beim Gehen nicht hinsehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate cuando mires la pantalla. La llegada se detecta sola, así que no hace falta mirar mientras caminas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez-vous pour regarder l’écran. L’arrivée est détectée automatiquement, inutile de regarder en marchant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 볼 때는 멈춰 서 주세요. 도착은 자동으로 판정되므로 걸으면서 볼 필요가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите на экран, только остановившись. Прибытие определяется автоматически — смотреть на ходу не нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看屏幕时请停下脚步。到达会自动判定，无需边走边看。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन देखते समय रुक जाएँ। आगमन अपने आप पहचाना जाता है, इसलिए चलते हुए देखने की ज़रूरत नहीं।"
          }
        }
      }
    },
    "私有地に入らない": {
      "extractionState": "manual",
      "localizations": {
