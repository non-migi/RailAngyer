        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterstützung fließt in neue Strecken und die Serverkosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apoyo se destinará a añadir más rutas y a los costes del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre soutien servira à ajouter des parcours et à financer le serveur."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내 주신 마음은 코스를 늘리는 수고와 서버 운영 비용에 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша поддержка пойдёт на новые маршруты и содержание сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的心意将用于增加路线和维持服务器运转。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका समर्थन नए मार्ग जोड़ने और सर्वर चलाने के खर्च में लगाया जाएगा।"
          }
        }
      }
    },
