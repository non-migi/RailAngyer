          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिशन पूरा करें"
          }
        }
      }
    },
    "着いた駅のお題が1つ引かれます。終わったら次のサイコロへ。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着いた駅のお題が1つ引かれます。終わったら次のサイコロへ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One mission at the station you land on is drawn. When it’s done, on to the next roll."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der erreichten Station wird eine Aufgabe gezogen. Danach geht’s zum nächsten Wurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se saca una misión de la estación a la que llegues. Al terminar, al siguiente tiro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un défi de la station atteinte est tiré. Une fois fini, au lancer suivant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착한 역의 미션이 1개 뽑힙니다. 끝나면 다음 주사위로."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вытягивается одно задание станции, куда вы попали. Выполнили — к следующему броску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会抽取到达车站的一个任务。完成后进行下一次掷骰。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँचे स्टेशन का एक मिशन निकाला जाता है। पूरा होने पर अगले पासे की ओर।"
          }
        }
      }
    },
    "駅に着いたのに反応しないとき": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅に着いたのに反応しないとき"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nothing happens when you arrive at a station"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bei der Ankunft nichts passiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no reacciona al llegar a una estación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien ne se passe à l’arrivée en station"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역에 도착했는데 반응이 없을 때"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если по прибытии на станцию ничего не происходит"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到站后没有反应时"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेशन पहुँचने पर भी प्रतिक्रिया न हो तो"
          }
        }
      }
    },
    "画面下の「ここに着いた」で手動でも進めます。GPSがずれる場所や、地下では届かないことがあります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面下の「ここに着いた」で手動でも進めます。GPSがずれる場所や、地下では届かないことがあります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also advance manually with “I arrived here” at the bottom of the screen. GPS can drift in some places and may not reach underground."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Hier angekommen“ unten am Bildschirm geht es auch manuell weiter. GPS kann mancherorts abweichen und unterirdisch fehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes avanzar manualmente con «He llegado» abajo en la pantalla. El GPS puede desviarse en algunos lugares y no llegar bajo tierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi avancer manuellement avec « Je suis arrivé » en bas de l’écran. Le GPS peut dériver par endroits et ne pas passer sous terre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래의 ‘여기에 도착했다’로 수동으로도 진행할 수 있습니다. GPS가 어긋나는 곳이나 지하에서는 안 잡힐 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно продвинуться и вручную кнопкой «Я прибыл» внизу экрана. GPS местами сбоит и не ловит под землёй."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可用屏幕下方的“已到达这里”手动前进。GPS 在某些地方会偏移，地下可能收不到信号。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन के नीचे “यहाँ पहुँच गया” से हाथ से भी आगे बढ़ सकते हैं। कुछ जगहों पर GPS भटक सकता है और भूमिगत में नहीं पहुँच पाता।"
          }
        }
      }
    },
    "圏外でも遊べます": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圏外でも遊べます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can play offline"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch ohne Empfang spielbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes jugar sin cobertura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouable même hors réseau"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권외에서도 놀 수 있습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно играть и вне сети"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有信号也能玩"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क न होने पर भी खेल सकते हैं"
          }
        }
      }
    },
    "記録は端末に残り、電波が戻ったときにまとめて共有されます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録は端末に残り、電波が戻ったときにまとめて共有されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay on your device and are shared all at once when you’re back in signal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnungen bleiben auf dem Gerät und werden bei Empfang gesammelt geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros quedan en el dispositivo y se comparten de golpe al recuperar la señal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements restent sur l’appareil et sont partagés d’un coup au retour du signal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 기기에 남고, 전파가 돌아오면 한꺼번에 공유됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи хранятся на устройстве и отправляются разом, когда появится связь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录会保留在本机，信号恢复时一并共享。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड डिवाइस पर रहते हैं और सिग्नल लौटने पर एक साथ साझा हो जाते हैं।"
          }
        }
      }
    },
    "みんなで遊ぶには": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなで遊ぶには"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To play together"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So spielt ihr gemeinsam"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jugar juntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour jouer ensemble"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 놀려면"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы играть вместе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想一起玩时"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साथ में खेलने के लिए"
          }
        }
      }
    },
    "設定＞みんなで遊ぶ からルームを作り、招待コードか共有リンクを仲間に渡します。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定＞みんなで遊ぶ からルームを作り、招待コードか共有リンクを仲間に渡します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a room from Settings > Play together, then give your group the invite code or a share link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle unter Einstellungen > Gemeinsam spielen einen Raum und gib deiner Gruppe den Einladungscode oder einen Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sala en Ajustes > Jugar juntos y pasa a tu grupo el código de invitación o un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un salon via Réglages > Jouer ensemble, puis donnez le code d’invitation ou un lien à votre groupe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 함께 놀기에서 방을 만들고, 초대 코드나 공유 링크를 동료에게 전합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте комнату в «Настройки > Играть вместе» и передайте своим код приглашения или ссылку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从设置＞一起玩创建房间，把邀请码或共享链接交给同伴。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स > साथ में खेलें से रूम बनाएँ और साथियों को निमंत्रण कोड या साझा लिंक दें।"
          }
        }
      }
    },
    "お題を先に見せるかどうか": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お題を先に見せるかどうか"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether to show missions in advance"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben vorab zeigen oder nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o no las misiones por adelantado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrer ou non les défis à l’avance"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션을 미리 보여줄지"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать ли задания заранее"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否提前公开任务"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिशन पहले दिखाएँ या नहीं"
          }
        }
      }
    },
    "設定＞お題の見え方 で、当日までのお楽しみにするか、いつでも見えるようにするかを選べます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定＞お題の見え方 で、当日までのお楽しみにするか、いつでも見えるようにするかを選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings > When missions are visible, choose between keeping them a surprise until the day or making them visible anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen > Sichtbarkeit der Aufgaben wählst du zwischen Überraschung bis zum Tag selbst und jederzeit sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes > Visibilidad de las misiones puedes elegir entre sorpresa hasta el día o visibles en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages > Visibilité des défis, choisissez entre surprise jusqu’au jour J et visibles à tout moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 미션 공개 방식에서 당일까지 비밀로 할지, 언제든 보이게 할지 선택할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройки > Видимость заданий» выберите: сюрприз до самого дня или видно всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置＞任务可见性中，可选择当天前保密或随时可见。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स > मिशन की दृश्यता में चुनें: उस दिन तक राज़ रखें या कभी भी दिखे।"
          }
        }
      }
    },
    "困ったとき": {
