          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing written yet. Tap + in the top right to add one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts geschrieben. Tippe oben rechts auf +, um eine hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has escrito nada. Toca + arriba a la derecha para añadir una."
          }
