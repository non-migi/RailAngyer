    "毎ターン必ず1駅ずつ進みます": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎ターン必ず1駅ずつ進みます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You always move exactly 1 station each turn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Zug geht es immer genau 1 Station weiter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada turno avanzas exactamente 1 estación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque tour, vous avancez toujours d’une station"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 반드시 1개 역씩 나아갑니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый ход вы продвигаетесь ровно на 1 станцию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合必定前进 1 站"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चाल में हमेशा 1 स्टेशन आगे बढ़ेंगे"
          }
        }
      }
    },
    "サイコロを振らず、1駅ずつ順に歩きます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイコロを振らず、1駅ずつ順に歩きます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No dice rolls — you walk station by station in order."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Würfeln geht es Station für Station der Reihe nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tirar el dado, caminas estación a estación en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans lancer de dé, vous marchez station par station, dans l’ordre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주사위를 굴리지 않고 1개 역씩 차례로 걷습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без кубика — вы идёте от станции к станции по порядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不掷骰子，按顺序一站一站走。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासा फेंके बिना, क्रम से एक-एक स्टेशन चलेंगे।"
          }
        }
      }
    },
