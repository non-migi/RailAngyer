    "最初の通信はサーバーの起動待ちで1分ほどかかることがあります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の通信はサーバーの起動待ちで1分ほどかかることがあります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first connection may take about a minute while the server wakes up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Verbindung kann etwa eine Minute dauern, während der Server startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera conexión puede tardar un minuto mientras el servidor arranca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première connexion peut prendre environ une minute, le temps que le serveur démarre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 통신은 서버 기동 대기로 1분 정도 걸릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое подключение может занять около минуты, пока сервер запускается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接可能需等待服务器启动约 1 分钟。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले कनेक्शन में सर्वर के चालू होने के इंतज़ार में लगभग एक मिनट लग सकता है।"
          }
        }
      }
    },
