    "訪問記録と写真は過去の旅として残ります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問記録と写真は過去の旅として残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your visit records and photos are kept as a past journey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuche und Fotos bleiben als vergangene Reise erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de visitas y las fotos se conservan como un viaje pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les visites et les photos sont conservées comme voyage passé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문 기록과 사진은 지난 여행으로 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
