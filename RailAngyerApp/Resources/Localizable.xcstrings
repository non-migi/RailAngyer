            "value": "मिशन खेलने का तरीक़ा"
          }
        }
      }
    },
    "引いたお題と結果はこの端末に記録されます。仲間の画面には出ません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引いたお題と結果はこの端末に記録されます。仲間の画面には出ません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn missions and results are recorded on this device. They won’t appear on your friends’ screens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezogene Aufgaben und Ergebnisse werden auf diesem Gerät gespeichert. Bei den anderen erscheinen sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las misiones sacadas y sus resultados se registran en este dispositivo. No aparecerán en las pantallas de tus compañeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défis tirés et leurs résultats sont enregistrés sur cet appareil. Ils n’apparaissent pas chez vos compagnons."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뽑은 미션과 결과는 이 기기에 기록됩니다. 동료의 화면에는 나오지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вытянутые задания и результаты хранятся на этом устройстве. У товарищей они не появятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽到的任务和结果记录在本机上，不会出现在同伴的屏幕上。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निकाले गए मिशन और नतीजे इसी डिवाइस पर दर्ज होते हैं। साथियों की स्क्रीन पर नहीं दिखेंगे।"
          }
        }
      }
    },
    "自分のお題も抽選に含める": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のお題も抽選に含める"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include my own missions in the draw"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Aufgaben in die Ziehung aufnehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mis propias misiones en el sorteo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure mes propres défis au tirage"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 미션도 추첨에 포함"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
