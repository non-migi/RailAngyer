      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末からも仲間の画面からも消えます。元には戻せません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from this device and from your friends’ screens. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verschwindet von diesem Gerät und bei den anderen. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparecerá de este dispositivo y de las pantallas de tus compañeros. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle disparaîtra de cet appareil et de chez vos compagnons. Cette action est irréversible."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서도 동료의 화면에서도 사라집니다. 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото исчезнет и с этого устройства, и у товарищей. Отменить нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从本机和同伴的屏幕上删除，无法恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस और साथियों की स्क्रीन दोनों से हट जाएगी। इसे वापस नहीं लाया जा सकता।"
          }
        }
      }
    },
