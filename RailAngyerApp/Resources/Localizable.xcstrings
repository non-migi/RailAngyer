    "お題は駅の外でも構いませんが、入れる場所だけにしてください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お題は駅の外でも構いませんが、入れる場所だけにしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missions can be outside the station, but keep to places you’re allowed to enter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben dürfen auch außerhalb der Station sein, aber nur an zugänglichen Orten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las misiones pueden estar fuera de la estación, pero solo en lugares donde se pueda entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défis peuvent être hors de la station, mais uniquement dans des lieux accessibles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션은 역 밖이어도 괜찮지만, 들어갈 수 있는 곳으로만 해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания могут быть и вне станции, но только там, куда можно заходить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
