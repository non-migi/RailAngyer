            "value": "Choisir le parcours et la section"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코스와 구간 정하기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите маршрут и участок"
          }
        },
        "zh-Hans": {
          "stringUnit": {
