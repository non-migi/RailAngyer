    "未送信の記録は送られないまま消えます。端末の記録は残ります。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信の記録は送られないまま消えます。端末の記録は残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsent records will be discarded without being sent. Records on this device will remain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gesendete Aufzeichnungen gehen verloren. Die Aufzeichnungen auf dem Gerät bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros sin enviar se perderán. Los registros del dispositivo se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements non envoyés seront perdus. Ceux de l’appareil seront conservés."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미전송 기록은 보내지지 않은 채 사라집니다. 기기의 기록은 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неотправленные записи пропадут. Записи на устройстве сохранятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送的记录将不再发送并消失。本机记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना भेजे गए रिकॉर्ड भेजे बिना ही मिट जाएँगे। डिवाइस के रिकॉर्ड बने रहेंगे।"
          }
        }
      }
    },
    "いまの旅を保存して参加しますか": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの旅を保存して参加しますか"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the current journey and join?"
          }
        },
        "de": {
          "stringUnit": {
