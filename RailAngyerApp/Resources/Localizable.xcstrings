            "value": "जिस देश में चलना चाहते हैं, वह चुनें।"
          }
        }
      }
    },
    "選ぶとすぐに切り替わります。訳が入っていないところは日本語のまま出ます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選ぶとすぐに切り替わります。訳が入っていないところは日本語のまま出ます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect right away. Anything not yet translated stays in Japanese."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt sofort. Noch nicht Übersetztes bleibt auf Japanisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica de inmediato. Lo aún no traducido se queda en japonés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effet immédiat. Ce qui n’est pas encore traduit reste en japonais."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고르면 바로 바뀝니다. 번역되지 않은 곳은 일본어로 나옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется сразу. Непереведённое останется на японском."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后立即生效。尚未翻译的部分仍显示日语。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनते ही तुरंत बदल जाता है। जिनका अनुवाद नहीं है, वे जापानी में ही दिखेंगे।"
          }
        }
      }
    },
