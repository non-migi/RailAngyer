    "みんなに届けられませんでした。電波が戻ったら設定を開き直してください": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなに届けられませんでした。電波が戻ったら設定を開き直してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t share it with everyone. Reopen the settings once you have signal again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht an alle übermittelt werden. Öffne die Einstellungen erneut, sobald wieder Empfang besteht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar a todos. Vuelve a abrir los ajustes cuando recuperes la señal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de l’envoyer à tous. Rouvrez les réglages quand le signal revient"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두에게 전하지 못했습니다. 전파가 돌아오면 설정을 다시 열어 주세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить всем. Когда появится связь, откройте настройки заново"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能发送给大家。信号恢复后请重新打开设置"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबको नहीं भेजा जा सका। सिग्नल लौटने पर सेटिंग्स फिर से खोलें"
          }
        }
      }
    },
