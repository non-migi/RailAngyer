    "実際の道を歩く遊びです。周りの人と交通に気をつけてください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の道を歩く遊びです。周りの人と交通に気をつけてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game is played on real streets. Watch out for people and traffic around you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel findet auf echten Wegen statt. Achte auf Menschen und Verkehr um dich herum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego se juega en calles reales. Presta atención a la gente y al tráfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu se joue sur de vraies routes. Faites attention aux gens et à la circulation."
